<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop;net10.0-browserwasm</TargetFrameworks>
    <TargetFrameworks Condition="'$(CadSpaceDesktopOnly)' == 'true'">net10.0-desktop</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <Description>Uno Platform CAD workspace controls for CadSpace: viewport, ribbon, palettes, managers, command console and navigation.</Description>
    <UnoSingleProject>true</UnoSingleProject><OutputType>Library</OutputType><GenerateLibraryLayout>true</GenerateLibraryLayout>
    <UnoFeatures>SkiaRenderer;GLCanvas;</UnoFeatures><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-browserwasm' and '$(Configuration)' == 'Release' and '$(CadSpaceUntrimmed)' != 'true'">
    <UnoXamlResourcesTrimming>true</UnoXamlResourcesTrimming>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CadSpace.Engine/CadSpace.Engine.csproj" />
    <ProjectReference Include="../CadSpace.Rendering/CadSpace.Rendering.csproj" />
    <PackageReference Include="Uno.WinUI.Graphics3DGL" Version="6.7.135" Condition="'$(TargetFramework)' == 'net10.0-browserwasm'" />
  </ItemGroup>
</Project>
